# Merge events and their autonomous resolutions as portable Env DSL.
# Source: https://github.com/wellmanifest/env-dsl
# Each event names exactly one actor, action, next state and priority.
# A consumer evaluates FACT_EVENT, follows the one true ROUTE_*_CONDITION
# and reads that event's constants. When several events hold at once, the
# highest EVENT_*_PRIORITY is resolved first. Evaluation is descriptive data;
# it authorizes nothing. See docs/MERGE_EVENTS.md.
ENV_DSL_VERSION=1
ENV_DSL_NAMESPACE=WELLMANIFEST_MERGE_EVENTS
ENV_DSL_ENVIRONMENT=BASE

# --- The observed event. BASE describes the reference case.
FACT_EVENT=CHECKS_GREEN

# --- The resolution matrix. Actors: INTERACTIVE_AGENT, ONEDEV_AGENT, VALIDATOR_AGENT.
# --- The owner is never an actor; NOTIFY=OWNER is an out-of-band notice only.
EVENT_BYPASS_REQUESTED_ACTOR=INTERACTIVE_AGENT
EVENT_BYPASS_REQUESTED_ACTION=REFUSE_AND_REQUEST_AUTONOMOUS_MERGE
EVENT_BYPASS_REQUESTED_NEXT=AWAITING_VALIDATOR
EVENT_BYPASS_REQUESTED_NOTIFY=NONE
EVENT_BYPASS_REQUESTED_PRIORITY=100
EVENT_BYPASS_REQUESTED_BLOCKS_MERGE=TRUE
EVENT_BYPASS_REQUESTED_AUTONOMOUS=TRUE
EVENT_SECRET_DETECTED_ACTOR=INTERACTIVE_AGENT
EVENT_SECRET_DETECTED_ACTION=REMOVE_SECRET_REBUILD_BRANCH_AND_PUSH
EVENT_SECRET_DETECTED_NEXT=CHANGES_REQUIRED
EVENT_SECRET_DETECTED_NOTIFY=OWNER
EVENT_SECRET_DETECTED_PRIORITY=99
EVENT_SECRET_DETECTED_BLOCKS_MERGE=TRUE
EVENT_SECRET_DETECTED_AUTONOMOUS=TRUE
EVENT_FOREIGN_DIRTY_CHECKOUT_ACTOR=INTERACTIVE_AGENT
EVENT_FOREIGN_DIRTY_CHECKOUT_ACTION=PRESERVE_AND_USE_LINKED_WORKTREE
EVENT_FOREIGN_DIRTY_CHECKOUT_NEXT=DRAFT
EVENT_FOREIGN_DIRTY_CHECKOUT_NOTIFY=NONE
EVENT_FOREIGN_DIRTY_CHECKOUT_PRIORITY=96
EVENT_FOREIGN_DIRTY_CHECKOUT_BLOCKS_MERGE=TRUE
EVENT_FOREIGN_DIRTY_CHECKOUT_AUTONOMOUS=TRUE
EVENT_REPOSITORY_NOT_ENROLLED_ACTOR=INTERACTIVE_AGENT
EVENT_REPOSITORY_NOT_ENROLLED_ACTION=OPEN_ENROLLMENT_TICKETS_IN_VALIDATOR_AND_ONEDEV
EVENT_REPOSITORY_NOT_ENROLLED_NEXT=AWAITING_ENROLLMENT
EVENT_REPOSITORY_NOT_ENROLLED_NOTIFY=NONE
EVENT_REPOSITORY_NOT_ENROLLED_PRIORITY=92
EVENT_REPOSITORY_NOT_ENROLLED_BLOCKS_MERGE=TRUE
EVENT_REPOSITORY_NOT_ENROLLED_AUTONOMOUS=TRUE
EVENT_INTENT_SCOPE_VIOLATION_ACTOR=INTERACTIVE_AGENT
EVENT_INTENT_SCOPE_VIOLATION_ACTION=RETURN_TO_PLAN_AND_AMEND_INTENT
EVENT_INTENT_SCOPE_VIOLATION_NEXT=REPLANNING
EVENT_INTENT_SCOPE_VIOLATION_NOTIFY=NONE
EVENT_INTENT_SCOPE_VIOLATION_PRIORITY=88
EVENT_INTENT_SCOPE_VIOLATION_BLOCKS_MERGE=TRUE
EVENT_INTENT_SCOPE_VIOLATION_AUTONOMOUS=TRUE
EVENT_BUDGET_EXCEEDED_ACTOR=INTERACTIVE_AGENT
EVENT_BUDGET_EXCEEDED_ACTION=SPLIT_INTO_DEPENDENT_TICKETS
EVENT_BUDGET_EXCEEDED_NEXT=REPLANNING
EVENT_BUDGET_EXCEEDED_NOTIFY=NONE
EVENT_BUDGET_EXCEEDED_PRIORITY=86
EVENT_BUDGET_EXCEEDED_BLOCKS_MERGE=TRUE
EVENT_BUDGET_EXCEEDED_AUTONOMOUS=TRUE
EVENT_CHECKS_NOT_RUN_ACTOR=ONEDEV_AGENT
EVENT_CHECKS_NOT_RUN_ACTION=RUN_LOCAL_VERIFY_ON_EXACT_MERGE_RESULT
EVENT_CHECKS_NOT_RUN_NEXT=AWAITING_LOCAL_VERIFY
EVENT_CHECKS_NOT_RUN_NOTIFY=OWNER
EVENT_CHECKS_NOT_RUN_PRIORITY=82
EVENT_CHECKS_NOT_RUN_BLOCKS_MERGE=TRUE
EVENT_CHECKS_NOT_RUN_AUTONOMOUS=TRUE
EVENT_GOVERNANCE_FAILED_ACTOR=INTERACTIVE_AGENT
EVENT_GOVERNANCE_FAILED_ACTION=APPLY_DIAGNOSTIC_RUNBOOK
EVENT_GOVERNANCE_FAILED_NEXT=CHANGES_REQUIRED
EVENT_GOVERNANCE_FAILED_NOTIFY=NONE
EVENT_GOVERNANCE_FAILED_PRIORITY=80
EVENT_GOVERNANCE_FAILED_BLOCKS_MERGE=TRUE
EVENT_GOVERNANCE_FAILED_AUTONOMOUS=TRUE
EVENT_MERGE_CONFLICT_ACTOR=INTERACTIVE_AGENT
EVENT_MERGE_CONFLICT_ACTION=REBUILD_REBASE_RETEST_AND_PUSH
EVENT_MERGE_CONFLICT_NEXT=AWAITING_CHECKS
EVENT_MERGE_CONFLICT_NOTIFY=NONE
EVENT_MERGE_CONFLICT_PRIORITY=76
EVENT_MERGE_CONFLICT_BLOCKS_MERGE=TRUE
EVENT_MERGE_CONFLICT_AUTONOMOUS=TRUE
EVENT_CHANGES_REQUESTED_ACTOR=INTERACTIVE_AGENT
EVENT_CHANGES_REQUESTED_ACTION=ADDRESS_FINDINGS_ON_TICKET_BRANCH
EVENT_CHANGES_REQUESTED_NEXT=CHANGES_REQUIRED
EVENT_CHANGES_REQUESTED_NOTIFY=NONE
EVENT_CHANGES_REQUESTED_PRIORITY=74
EVENT_CHANGES_REQUESTED_BLOCKS_MERGE=TRUE
EVENT_CHANGES_REQUESTED_AUTONOMOUS=TRUE
EVENT_CHECKS_FAILED_ACTOR=INTERACTIVE_AGENT
EVENT_CHECKS_FAILED_ACTION=FIX_ON_TICKET_BRANCH_AND_PUSH
EVENT_CHECKS_FAILED_NEXT=AWAITING_CHECKS
EVENT_CHECKS_FAILED_NOTIFY=NONE
EVENT_CHECKS_FAILED_PRIORITY=72
EVENT_CHECKS_FAILED_BLOCKS_MERGE=TRUE
EVENT_CHECKS_FAILED_AUTONOMOUS=TRUE
EVENT_LOCAL_VERIFY_FAILED_ACTOR=INTERACTIVE_AGENT
EVENT_LOCAL_VERIFY_FAILED_ACTION=FIX_ON_TICKET_BRANCH_AND_PUSH
EVENT_LOCAL_VERIFY_FAILED_NEXT=AWAITING_LOCAL_VERIFY
EVENT_LOCAL_VERIFY_FAILED_NOTIFY=NONE
EVENT_LOCAL_VERIFY_FAILED_PRIORITY=70
EVENT_LOCAL_VERIFY_FAILED_BLOCKS_MERGE=TRUE
EVENT_LOCAL_VERIFY_FAILED_AUTONOMOUS=TRUE
EVENT_SCOPE_RESERVED_ACTOR=INTERACTIVE_AGENT
EVENT_SCOPE_RESERVED_ACTION=SERIALIZE_AFTER_OWNING_TICKET
EVENT_SCOPE_RESERVED_NEXT=SERIALIZED
EVENT_SCOPE_RESERVED_NOTIFY=NONE
EVENT_SCOPE_RESERVED_PRIORITY=62
EVENT_SCOPE_RESERVED_BLOCKS_MERGE=TRUE
EVENT_SCOPE_RESERVED_AUTONOMOUS=TRUE
EVENT_DUPLICATE_WORK_ACTOR=ONEDEV_AGENT
EVENT_DUPLICATE_WORK_ACTION=CONSOLIDATE_SHARED_TICKETS_WITH_RECEIPT
EVENT_DUPLICATE_WORK_NEXT=CLOSED
EVENT_DUPLICATE_WORK_NOTIFY=NONE
EVENT_DUPLICATE_WORK_PRIORITY=58
EVENT_DUPLICATE_WORK_BLOCKS_MERGE=TRUE
EVENT_DUPLICATE_WORK_AUTONOMOUS=TRUE
EVENT_SUPERSEDED_ACTOR=ONEDEV_AGENT
EVENT_SUPERSEDED_ACTION=CONSOLIDATE_SUPERSEDED_WITH_RECEIPT
EVENT_SUPERSEDED_NEXT=CLOSED
EVENT_SUPERSEDED_NOTIFY=NONE
EVENT_SUPERSEDED_PRIORITY=56
EVENT_SUPERSEDED_BLOCKS_MERGE=TRUE
EVENT_SUPERSEDED_AUTONOMOUS=TRUE
EVENT_PR_OPENED_ACTOR=INTERACTIVE_AGENT
EVENT_PR_OPENED_ACTION=REQUEST_AUTONOMOUS_MERGE
EVENT_PR_OPENED_NEXT=AWAITING_CHECKS
EVENT_PR_OPENED_NOTIFY=NONE
EVENT_PR_OPENED_PRIORITY=50
EVENT_PR_OPENED_BLOCKS_MERGE=TRUE
EVENT_PR_OPENED_AUTONOMOUS=TRUE
EVENT_STALE_PULL_REQUEST_ACTOR=ONEDEV_AGENT
EVENT_STALE_PULL_REQUEST_ACTION=REBUILD_OR_DEFER_BY_INTENT_DELTA
EVENT_STALE_PULL_REQUEST_NEXT=AWAITING_CHECKS
EVENT_STALE_PULL_REQUEST_NOTIFY=NONE
EVENT_STALE_PULL_REQUEST_PRIORITY=46
EVENT_STALE_PULL_REQUEST_BLOCKS_MERGE=TRUE
EVENT_STALE_PULL_REQUEST_AUTONOMOUS=TRUE
EVENT_CHECKS_PENDING_ACTOR=VALIDATOR_AGENT
EVENT_CHECKS_PENDING_ACTION=WAIT_FOR_EXACT_HEAD_CHECKS
EVENT_CHECKS_PENDING_NEXT=AWAITING_CHECKS
EVENT_CHECKS_PENDING_NOTIFY=NONE
EVENT_CHECKS_PENDING_PRIORITY=40
EVENT_CHECKS_PENDING_BLOCKS_MERGE=TRUE
EVENT_CHECKS_PENDING_AUTONOMOUS=TRUE
EVENT_HEAD_CHANGED_ACTOR=VALIDATOR_AGENT
EVENT_HEAD_CHANGED_ACTION=START_NEW_EXACT_HEAD_EPOCH
EVENT_HEAD_CHANGED_NEXT=AWAITING_CHECKS
EVENT_HEAD_CHANGED_NOTIFY=NONE
EVENT_HEAD_CHANGED_PRIORITY=34
EVENT_HEAD_CHANGED_BLOCKS_MERGE=TRUE
EVENT_HEAD_CHANGED_AUTONOMOUS=TRUE
EVENT_BASE_ADVANCED_ACTOR=VALIDATOR_AGENT
EVENT_BASE_ADVANCED_ACTION=VERIFY_MERGE_RESULT_AGAINST_CURRENT_BASE
EVENT_BASE_ADVANCED_NEXT=AWAITING_CHECKS
EVENT_BASE_ADVANCED_NOTIFY=NONE
EVENT_BASE_ADVANCED_PRIORITY=32
EVENT_BASE_ADVANCED_BLOCKS_MERGE=TRUE
EVENT_BASE_ADVANCED_AUTONOMOUS=TRUE
EVENT_VALIDATOR_UNAVAILABLE_ACTOR=ONEDEV_AGENT
EVENT_VALIDATOR_UNAVAILABLE_ACTION=QUEUE_REDISPATCH_WITH_BACKOFF_AND_OPEN_INCIDENT
EVENT_VALIDATOR_UNAVAILABLE_NEXT=AWAITING_VALIDATOR
EVENT_VALIDATOR_UNAVAILABLE_NOTIFY=OWNER
EVENT_VALIDATOR_UNAVAILABLE_PRIORITY=24
EVENT_VALIDATOR_UNAVAILABLE_BLOCKS_MERGE=TRUE
EVENT_VALIDATOR_UNAVAILABLE_AUTONOMOUS=TRUE
EVENT_RATE_LIMITED_ACTOR=VALIDATOR_AGENT
EVENT_RATE_LIMITED_ACTION=WAIT_RETRY_AFTER_THEN_RESCAN
EVENT_RATE_LIMITED_NEXT=AWAITING_VALIDATOR
EVENT_RATE_LIMITED_NOTIFY=NONE
EVENT_RATE_LIMITED_PRIORITY=20
EVENT_RATE_LIMITED_BLOCKS_MERGE=TRUE
EVENT_RATE_LIMITED_AUTONOMOUS=TRUE
EVENT_ORPHAN_BRANCH_ACTOR=ONEDEV_AGENT
EVENT_ORPHAN_BRANCH_ACTION=PRUNE_WITH_RECOVERY_RECEIPT
EVENT_ORPHAN_BRANCH_NEXT=CLOSED
EVENT_ORPHAN_BRANCH_NOTIFY=NONE
EVENT_ORPHAN_BRANCH_PRIORITY=15
EVENT_ORPHAN_BRANCH_BLOCKS_MERGE=FALSE
EVENT_ORPHAN_BRANCH_AUTONOMOUS=TRUE
EVENT_LOCAL_VERIFY_GREEN_ACTOR=VALIDATOR_AGENT
EVENT_LOCAL_VERIFY_GREEN_ACTION=VALIDATE_APPROVE_AND_MERGE_EXACT_HEAD
EVENT_LOCAL_VERIFY_GREEN_NEXT=MERGED
EVENT_LOCAL_VERIFY_GREEN_NOTIFY=NONE
EVENT_LOCAL_VERIFY_GREEN_PRIORITY=12
EVENT_LOCAL_VERIFY_GREEN_BLOCKS_MERGE=FALSE
EVENT_LOCAL_VERIFY_GREEN_AUTONOMOUS=TRUE
EVENT_CHECKS_GREEN_ACTOR=VALIDATOR_AGENT
EVENT_CHECKS_GREEN_ACTION=VALIDATE_APPROVE_AND_MERGE_EXACT_HEAD
EVENT_CHECKS_GREEN_NEXT=MERGED
EVENT_CHECKS_GREEN_NOTIFY=NONE
EVENT_CHECKS_GREEN_PRIORITY=10
EVENT_CHECKS_GREEN_BLOCKS_MERGE=FALSE
EVENT_CHECKS_GREEN_AUTONOMOUS=TRUE
EVENT_MERGED_ACTOR=ONEDEV_AGENT
EVENT_MERGED_ACTION=RELEASE_SCOPE_AND_RETIRE_WORKTREE_BY_LIFECYCLE
EVENT_MERGED_NEXT=CLOSED
EVENT_MERGED_NOTIFY=NONE
EVENT_MERGED_PRIORITY=5
EVENT_MERGED_BLOCKS_MERGE=FALSE
EVENT_MERGED_AUTONOMOUS=TRUE

# --- One route per event.
ROUTE_BYPASS_REQUESTED_CONDITION=@FACT_EVENT==:BYPASS_REQUESTED
ROUTE_SECRET_DETECTED_CONDITION=@FACT_EVENT==:SECRET_DETECTED
ROUTE_FOREIGN_DIRTY_CHECKOUT_CONDITION=@FACT_EVENT==:FOREIGN_DIRTY_CHECKOUT
ROUTE_REPOSITORY_NOT_ENROLLED_CONDITION=@FACT_EVENT==:REPOSITORY_NOT_ENROLLED
ROUTE_INTENT_SCOPE_VIOLATION_CONDITION=@FACT_EVENT==:INTENT_SCOPE_VIOLATION
ROUTE_BUDGET_EXCEEDED_CONDITION=@FACT_EVENT==:BUDGET_EXCEEDED
ROUTE_CHECKS_NOT_RUN_CONDITION=@FACT_EVENT==:CHECKS_NOT_RUN
ROUTE_GOVERNANCE_FAILED_CONDITION=@FACT_EVENT==:GOVERNANCE_FAILED
ROUTE_MERGE_CONFLICT_CONDITION=@FACT_EVENT==:MERGE_CONFLICT
ROUTE_CHANGES_REQUESTED_CONDITION=@FACT_EVENT==:CHANGES_REQUESTED
ROUTE_CHECKS_FAILED_CONDITION=@FACT_EVENT==:CHECKS_FAILED
ROUTE_LOCAL_VERIFY_FAILED_CONDITION=@FACT_EVENT==:LOCAL_VERIFY_FAILED
ROUTE_SCOPE_RESERVED_CONDITION=@FACT_EVENT==:SCOPE_RESERVED
ROUTE_DUPLICATE_WORK_CONDITION=@FACT_EVENT==:DUPLICATE_WORK
ROUTE_SUPERSEDED_CONDITION=@FACT_EVENT==:SUPERSEDED
ROUTE_PR_OPENED_CONDITION=@FACT_EVENT==:PR_OPENED
ROUTE_STALE_PULL_REQUEST_CONDITION=@FACT_EVENT==:STALE_PULL_REQUEST
ROUTE_CHECKS_PENDING_CONDITION=@FACT_EVENT==:CHECKS_PENDING
ROUTE_HEAD_CHANGED_CONDITION=@FACT_EVENT==:HEAD_CHANGED
ROUTE_BASE_ADVANCED_CONDITION=@FACT_EVENT==:BASE_ADVANCED
ROUTE_VALIDATOR_UNAVAILABLE_CONDITION=@FACT_EVENT==:VALIDATOR_UNAVAILABLE
ROUTE_RATE_LIMITED_CONDITION=@FACT_EVENT==:RATE_LIMITED
ROUTE_ORPHAN_BRANCH_CONDITION=@FACT_EVENT==:ORPHAN_BRANCH
ROUTE_LOCAL_VERIFY_GREEN_CONDITION=@FACT_EVENT==:LOCAL_VERIFY_GREEN
ROUTE_CHECKS_GREEN_CONDITION=@FACT_EVENT==:CHECKS_GREEN
ROUTE_MERGED_CONDITION=@FACT_EVENT==:MERGED

# --- Closed vocabulary: an unknown event resolves nowhere and fails closed.
EVENT_KNOWN_CONDITION=@ROUTE_BYPASS_REQUESTED_CONDITION||@ROUTE_SECRET_DETECTED_CONDITION||@ROUTE_FOREIGN_DIRTY_CHECKOUT_CONDITION||@ROUTE_REPOSITORY_NOT_ENROLLED_CONDITION||@ROUTE_INTENT_SCOPE_VIOLATION_CONDITION||@ROUTE_BUDGET_EXCEEDED_CONDITION||@ROUTE_CHECKS_NOT_RUN_CONDITION||@ROUTE_GOVERNANCE_FAILED_CONDITION||@ROUTE_MERGE_CONFLICT_CONDITION||@ROUTE_CHANGES_REQUESTED_CONDITION||@ROUTE_CHECKS_FAILED_CONDITION||@ROUTE_LOCAL_VERIFY_FAILED_CONDITION||@ROUTE_SCOPE_RESERVED_CONDITION||@ROUTE_DUPLICATE_WORK_CONDITION||@ROUTE_SUPERSEDED_CONDITION||@ROUTE_PR_OPENED_CONDITION||@ROUTE_STALE_PULL_REQUEST_CONDITION||@ROUTE_CHECKS_PENDING_CONDITION||@ROUTE_HEAD_CHANGED_CONDITION||@ROUTE_BASE_ADVANCED_CONDITION||@ROUTE_VALIDATOR_UNAVAILABLE_CONDITION||@ROUTE_RATE_LIMITED_CONDITION||@ROUTE_ORPHAN_BRANCH_CONDITION||@ROUTE_LOCAL_VERIFY_GREEN_CONDITION||@ROUTE_CHECKS_GREEN_CONDITION||@ROUTE_MERGED_CONDITION

# --- Invariants of the matrix itself.
# Only the Validator identity reaches MERGED; an interactive agent never merges.
MATRIX_ONLY_VALIDATOR_MERGES_CONDITION=(@EVENT_BYPASS_REQUESTED_NEXT!=:MERGED||@EVENT_BYPASS_REQUESTED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_SECRET_DETECTED_NEXT!=:MERGED||@EVENT_SECRET_DETECTED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_FOREIGN_DIRTY_CHECKOUT_NEXT!=:MERGED||@EVENT_FOREIGN_DIRTY_CHECKOUT_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_REPOSITORY_NOT_ENROLLED_NEXT!=:MERGED||@EVENT_REPOSITORY_NOT_ENROLLED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_INTENT_SCOPE_VIOLATION_NEXT!=:MERGED||@EVENT_INTENT_SCOPE_VIOLATION_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_BUDGET_EXCEEDED_NEXT!=:MERGED||@EVENT_BUDGET_EXCEEDED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_CHECKS_NOT_RUN_NEXT!=:MERGED||@EVENT_CHECKS_NOT_RUN_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_GOVERNANCE_FAILED_NEXT!=:MERGED||@EVENT_GOVERNANCE_FAILED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_MERGE_CONFLICT_NEXT!=:MERGED||@EVENT_MERGE_CONFLICT_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_CHANGES_REQUESTED_NEXT!=:MERGED||@EVENT_CHANGES_REQUESTED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_CHECKS_FAILED_NEXT!=:MERGED||@EVENT_CHECKS_FAILED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_LOCAL_VERIFY_FAILED_NEXT!=:MERGED||@EVENT_LOCAL_VERIFY_FAILED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_SCOPE_RESERVED_NEXT!=:MERGED||@EVENT_SCOPE_RESERVED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_DUPLICATE_WORK_NEXT!=:MERGED||@EVENT_DUPLICATE_WORK_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_SUPERSEDED_NEXT!=:MERGED||@EVENT_SUPERSEDED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_PR_OPENED_NEXT!=:MERGED||@EVENT_PR_OPENED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_STALE_PULL_REQUEST_NEXT!=:MERGED||@EVENT_STALE_PULL_REQUEST_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_CHECKS_PENDING_NEXT!=:MERGED||@EVENT_CHECKS_PENDING_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_HEAD_CHANGED_NEXT!=:MERGED||@EVENT_HEAD_CHANGED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_BASE_ADVANCED_NEXT!=:MERGED||@EVENT_BASE_ADVANCED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_VALIDATOR_UNAVAILABLE_NEXT!=:MERGED||@EVENT_VALIDATOR_UNAVAILABLE_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_RATE_LIMITED_NEXT!=:MERGED||@EVENT_RATE_LIMITED_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_ORPHAN_BRANCH_NEXT!=:MERGED||@EVENT_ORPHAN_BRANCH_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_LOCAL_VERIFY_GREEN_NEXT!=:MERGED||@EVENT_LOCAL_VERIFY_GREEN_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_CHECKS_GREEN_NEXT!=:MERGED||@EVENT_CHECKS_GREEN_ACTOR==:VALIDATOR_AGENT)&&(@EVENT_MERGED_NEXT!=:MERGED||@EVENT_MERGED_ACTOR==:VALIDATOR_AGENT)
# No event waits for a human decision.
MATRIX_NO_OWNER_ACTOR_CONDITION=@EVENT_BYPASS_REQUESTED_ACTOR!=:OWNER&&@EVENT_SECRET_DETECTED_ACTOR!=:OWNER&&@EVENT_FOREIGN_DIRTY_CHECKOUT_ACTOR!=:OWNER&&@EVENT_REPOSITORY_NOT_ENROLLED_ACTOR!=:OWNER&&@EVENT_INTENT_SCOPE_VIOLATION_ACTOR!=:OWNER&&@EVENT_BUDGET_EXCEEDED_ACTOR!=:OWNER&&@EVENT_CHECKS_NOT_RUN_ACTOR!=:OWNER&&@EVENT_GOVERNANCE_FAILED_ACTOR!=:OWNER&&@EVENT_MERGE_CONFLICT_ACTOR!=:OWNER&&@EVENT_CHANGES_REQUESTED_ACTOR!=:OWNER&&@EVENT_CHECKS_FAILED_ACTOR!=:OWNER&&@EVENT_LOCAL_VERIFY_FAILED_ACTOR!=:OWNER&&@EVENT_SCOPE_RESERVED_ACTOR!=:OWNER&&@EVENT_DUPLICATE_WORK_ACTOR!=:OWNER&&@EVENT_SUPERSEDED_ACTOR!=:OWNER&&@EVENT_PR_OPENED_ACTOR!=:OWNER&&@EVENT_STALE_PULL_REQUEST_ACTOR!=:OWNER&&@EVENT_CHECKS_PENDING_ACTOR!=:OWNER&&@EVENT_HEAD_CHANGED_ACTOR!=:OWNER&&@EVENT_BASE_ADVANCED_ACTOR!=:OWNER&&@EVENT_VALIDATOR_UNAVAILABLE_ACTOR!=:OWNER&&@EVENT_RATE_LIMITED_ACTOR!=:OWNER&&@EVENT_ORPHAN_BRANCH_ACTOR!=:OWNER&&@EVENT_LOCAL_VERIFY_GREEN_ACTOR!=:OWNER&&@EVENT_CHECKS_GREEN_ACTOR!=:OWNER&&@EVENT_MERGED_ACTOR!=:OWNER
MATRIX_FULLY_AUTONOMOUS_CONDITION=@EVENT_BYPASS_REQUESTED_AUTONOMOUS&&@EVENT_SECRET_DETECTED_AUTONOMOUS&&@EVENT_FOREIGN_DIRTY_CHECKOUT_AUTONOMOUS&&@EVENT_REPOSITORY_NOT_ENROLLED_AUTONOMOUS&&@EVENT_INTENT_SCOPE_VIOLATION_AUTONOMOUS&&@EVENT_BUDGET_EXCEEDED_AUTONOMOUS&&@EVENT_CHECKS_NOT_RUN_AUTONOMOUS&&@EVENT_GOVERNANCE_FAILED_AUTONOMOUS&&@EVENT_MERGE_CONFLICT_AUTONOMOUS&&@EVENT_CHANGES_REQUESTED_AUTONOMOUS&&@EVENT_CHECKS_FAILED_AUTONOMOUS&&@EVENT_LOCAL_VERIFY_FAILED_AUTONOMOUS&&@EVENT_SCOPE_RESERVED_AUTONOMOUS&&@EVENT_DUPLICATE_WORK_AUTONOMOUS&&@EVENT_SUPERSEDED_AUTONOMOUS&&@EVENT_PR_OPENED_AUTONOMOUS&&@EVENT_STALE_PULL_REQUEST_AUTONOMOUS&&@EVENT_CHECKS_PENDING_AUTONOMOUS&&@EVENT_HEAD_CHANGED_AUTONOMOUS&&@EVENT_BASE_ADVANCED_AUTONOMOUS&&@EVENT_VALIDATOR_UNAVAILABLE_AUTONOMOUS&&@EVENT_RATE_LIMITED_AUTONOMOUS&&@EVENT_ORPHAN_BRANCH_AUTONOMOUS&&@EVENT_LOCAL_VERIFY_GREEN_AUTONOMOUS&&@EVENT_CHECKS_GREEN_AUTONOMOUS&&@EVENT_MERGED_AUTONOMOUS

# --- One conjunction decides whether the observed event has an admissible resolution.
EVENT_RESOLVED_CONDITION=@EVENT_KNOWN_CONDITION&&@MATRIX_ONLY_VALIDATOR_MERGES_CONDITION&&@MATRIX_NO_OWNER_ACTOR_CONDITION&&@MATRIX_FULLY_AUTONOMOUS_CONDITION
