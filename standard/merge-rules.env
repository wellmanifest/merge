# Merge decision rules as portable Env DSL equations.
# Source: https://github.com/wellmanifest/env-dsl
# Every rule is an implication written with operators only: a disposition that
# does not apply satisfies its own rule vacuously, so one conjunction decides
# admissibility. Evaluation is descriptive data; it authorizes nothing.
ENV_DSL_VERSION=1
ENV_DSL_NAMESPACE=WELLMANIFEST_MERGE_DECISION
ENV_DSL_ENVIRONMENT=BASE

# --- Facts a decision presents. The BASE values describe the reference case:
# --- an orphaned branch whose intent is live but whose delivery fails the gate.
FACT_DISPOSITION=REBUILD
FACT_HAS_GATE_OUTCOME=TRUE
FACT_HAS_REACHABILITY=FALSE
FACT_HAS_HISTORY_SHAPE=TRUE
FACT_HAS_CONTENT_IDENTITY=TRUE
FACT_HAS_PATCH_EQUIVALENCE=FALSE
FACT_HAS_DEPENDENCY_EVIDENCE=FALSE
FACT_HAS_INTENT_DELTA=TRUE
FACT_HAS_RECOVERABILITY=TRUE
FACT_HAS_REPLACEMENT=FALSE
FACT_IDENTITY_TOTAL=32
FACT_IDENTITY_COMPARED=32
FACT_IDENTITY_MATCHED=0
FACT_DESTRUCTIVE=TRUE
FACT_RECOVERY_REF_COUNT=1
FACT_PATCH_RECOVERY=FALSE
FACT_CANDIDATE_RECOVERABLE=TRUE
FACT_DETERMINISTIC_EVIDENCE_COUNT=4
FACT_EFFECTFUL_ACTION_COUNT=3
FACT_EXECUTOR=INTERACTIVE_AGENT
FACT_AUTHORIZES_MERGE=FALSE
FACT_IN_SCAN_MATRIX=TRUE
FACT_IN_SCAN_CONFIG=FALSE
FACT_TICKET_DERIVABLE=TRUE
FACT_REQUIRED_CHECKS_GREEN=TRUE
FACT_APPROVED_AT_EXACT_HEAD=FALSE
FACT_STANDING_MERGE_POLICY=TRUE

# --- One rule per disposition. Read A!=:X||(Y) as "if the disposition is X
# --- then Y must hold".
RULE_ADOPT_CONDITION=@FACT_DISPOSITION!=:ADOPT||(@FACT_HAS_GATE_OUTCOME&&@FACT_HAS_REACHABILITY)
RULE_REBUILD_CONDITION=@FACT_DISPOSITION!=:REBUILD||(@FACT_HAS_GATE_OUTCOME&&@FACT_HAS_HISTORY_SHAPE)
RULE_ALREADY_IMPLEMENTED_CONDITION=@FACT_DISPOSITION!=:ALREADY_IMPLEMENTED||(@FACT_HAS_CONTENT_IDENTITY&&@FACT_IDENTITY_TOTAL>0&&@FACT_IDENTITY_COMPARED==@FACT_IDENTITY_TOTAL&&@FACT_IDENTITY_MATCHED==@FACT_IDENTITY_TOTAL)
RULE_SUPERSEDED_CONDITION=@FACT_DISPOSITION!=:SUPERSEDED||(@FACT_HAS_PATCH_EQUIVALENCE&&@FACT_HAS_REPLACEMENT)
RULE_REGRESSIVE_CONDITION=@FACT_DISPOSITION!=:REGRESSIVE||(@FACT_HAS_CONTENT_IDENTITY&&@FACT_IDENTITY_MATCHED<@FACT_IDENTITY_TOTAL)
RULE_OBSOLETE_CONDITION=@FACT_DISPOSITION!=:OBSOLETE||@FACT_HAS_DEPENDENCY_EVIDENCE
RULE_DEFER_CONDITION=@FACT_DISPOSITION!=:DEFER||(@FACT_HAS_INTENT_DELTA&&@FACT_EFFECTFUL_ACTION_COUNT==0)

# --- Who may close a decision by merging. An interactive agent runs under the
# --- identity that pushed the branch, so its merge would be an unreviewed write
# --- and its approval a self-approval.
RULE_MERGE_EXECUTOR_CONDITION=!@FACT_AUTHORIZES_MERGE||@FACT_EXECUTOR!=:INTERACTIVE_AGENT

# --- The six conditions an autonomous merge needs, in the order they fail.
RULE_MERGE_PRECONDITIONS_CONDITION=!@FACT_AUTHORIZES_MERGE||@FACT_EXECUTOR==:OWNER||(@FACT_IN_SCAN_MATRIX&&@FACT_IN_SCAN_CONFIG&&@FACT_TICKET_DERIVABLE&&@FACT_REQUIRED_CHECKS_GREEN&&@FACT_APPROVED_AT_EXACT_HEAD&&@FACT_STANDING_MERGE_POLICY)

# --- Rules that hold for every disposition. These are the two destruction
# --- gates and the advisory-evidence bar.
RULE_DESTRUCTIVE_RECOVERY_CONDITION=!@FACT_DESTRUCTIVE||(@FACT_HAS_RECOVERABILITY&&@FACT_RECOVERY_REF_COUNT>0)
RULE_UNCOMMITTED_PATCH_CONDITION=!@FACT_DESTRUCTIVE||@FACT_CANDIDATE_RECOVERABLE||@FACT_PATCH_RECOVERY
RULE_ADVISORY_NOT_DESTRUCTIVE_CONDITION=!@FACT_DESTRUCTIVE||@FACT_DETERMINISTIC_EVIDENCE_COUNT>0

# --- One conjunction decides admissibility. A false result names no action; a
# --- governed consumer owns what happens next.
DECISION_ADMISSIBLE_CONDITION=@RULE_MERGE_EXECUTOR_CONDITION&&@RULE_MERGE_PRECONDITIONS_CONDITION&&@RULE_ADOPT_CONDITION&&@RULE_REBUILD_CONDITION&&@RULE_ALREADY_IMPLEMENTED_CONDITION&&@RULE_SUPERSEDED_CONDITION&&@RULE_REGRESSIVE_CONDITION&&@RULE_OBSOLETE_CONDITION&&@RULE_DEFER_CONDITION&&@RULE_DESTRUCTIVE_RECOVERY_CONDITION&&@RULE_UNCOMMITTED_PATCH_CONDITION&&@RULE_ADVISORY_NOT_DESTRUCTIVE_CONDITION
