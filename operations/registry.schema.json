{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/operations/v1",
  "title": "Wellmanifest CQRS operation registry v1",
  "description": "Closed source of truth for Commands, Queries, projections and transport-model bindings. Event and error metadata live in their own referenced catalogues.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "domain",
    "sourceOfTruth",
    "invariants",
    "models",
    "commands",
    "queries",
    "projections"
  ],
  "properties": {
    "$schema": {
      "const": "./registry.schema.json"
    },
    "schema": {
      "const": "wellmanifest.operations/v1"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sourceOfTruth": {
      "$ref": "#/$defs/sourceOfTruth"
    },
    "invariants": {
      "$ref": "#/$defs/invariants"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/projection"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandsAndQueries",
        "events",
        "errors",
        "models",
        "transportRule"
      ],
      "properties": {
        "commandsAndQueries": {
          "const": "operations/index.json"
        },
        "events": {
          "const": "events/index.json"
        },
        "errors": {
          "const": "error/index.json"
        },
        "models": {
          "type": "string",
          "minLength": 1
        },
        "transportRule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandEffectsBecomeFactsOnlyThroughEvents",
        "queriesAreEffectFree",
        "replayExecutesEffects",
        "eventsCarryAuthority",
        "modelsCarryAuthority"
      ],
      "properties": {
        "commandEffectsBecomeFactsOnlyThroughEvents": {
          "const": true
        },
        "queriesAreEffectFree": {
          "const": true
        },
        "replayExecutesEffects": {
          "const": false
        },
        "eventsCarryAuthority": {
          "const": false
        },
        "modelsCarryAuthority": {
          "const": false
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaRef",
        "transport",
        "authority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "schemaRef": {
          "type": "string",
          "pattern": "^[^#]+#/.*$"
        },
        "transport": {
          "enum": [
            "json-schema",
            "protobuf"
          ]
        },
        "authority": {
          "const": false
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "intent",
        "inputModel",
        "authority",
        "inputCarriesAuthority",
        "idempotency",
        "effect",
        "emits",
        "rejects"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "pattern": "^urn:wellmanifest:[a-z0-9-]+:command:[a-z0-9-]+$"
        },
        "intent": {
          "type": "string",
          "minLength": 10
        },
        "inputModel": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "const": "external-policy"
        },
        "inputCarriesAuthority": {
          "const": false
        },
        "idempotency": {
          "const": "required"
        },
        "effect": {
          "enum": [
            "append-events",
            "authorized-action-and-append-receipt"
          ]
        },
        "emits": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "rejects": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "intent",
        "inputModel",
        "outputModel",
        "cardinality",
        "projection",
        "consistency",
        "effect",
        "emits"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "pattern": "^urn:wellmanifest:[a-z0-9-]+:query:[a-z0-9-]+$"
        },
        "intent": {
          "type": "string",
          "minLength": 10
        },
        "inputModel": {
          "$ref": "#/$defs/id"
        },
        "outputModel": {
          "$ref": "#/$defs/id"
        },
        "cardinality": {
          "enum": [
            "one",
            "one-or-none",
            "many"
          ]
        },
        "projection": {
          "$ref": "#/$defs/id"
        },
        "consistency": {
          "enum": [
            "strong",
            "eventual"
          ]
        },
        "effect": {
          "const": "none"
        },
        "emits": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "outputModel",
        "cardinality",
        "rebuiltFrom",
        "reducer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "intent": {
          "type": "string",
          "minLength": 10
        },
        "outputModel": {
          "$ref": "#/$defs/id"
        },
        "cardinality": {
          "enum": [
            "one",
            "one-or-none",
            "many"
          ]
        },
        "rebuiltFrom": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "reducer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "deterministic",
            "effects"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "deterministic": {
              "const": true
            },
            "effects": {
              "const": false
            }
          }
        }
      }
    }
  }
}
